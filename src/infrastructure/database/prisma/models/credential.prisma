model Credential {
  @@schema("auth")
  @@map("credentials")

  id         String   @id @default(uuid())
  userId     String   @unique
  email      String   @unique
  password   String
  isVerified Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens RefreshToken[]
  sessions      Session[]
}